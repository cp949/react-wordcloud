{
  "name": "react-wordcloud-monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "React + D3 wordcloud component library with security fixes and modern tooling",
  "repository": {
    "type": "git",
    "url": "https://github.com/cp949/react-wordcloud.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "eslint-plugin-turbo": "^2.11.9",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "turbo": "^2.11.9",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=10.0.0"
  }
}
