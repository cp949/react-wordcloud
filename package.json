{
  "name": "react-wordcloud-monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "React + D3 wordcloud component library with security fixes and modern tooling",
  "repository": {
    "type": "git",
    "url": "https://github.com/cp949/react-wordcloud.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "turbo": "^2.10.11",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
