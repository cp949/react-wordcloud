{
  "name": "@cp949/react-wordcloud",
  "version": "1.0.3",
  "description": "React + D3 wordcloud component with security fixes and modern tooling",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .turbo node_modules",
    "prepublishOnly": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-cloud": "^1.2.9",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "lodash.debounce": "^4.0.8",
    "resize-observer-polyfill": "^1.5.1",
    "seedrandom": "^3.0.5",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-cloud": "^1.2.9",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/seedrandom": "^3.0.8",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cp949/react-wordcloud.git",
    "directory": "packages/react-wordcloud"
  },
  "bugs": {
    "url": "https://github.com/cp949/react-wordcloud/issues"
  },
  "homepage": "https://github.com/cp949/react-wordcloud#readme",
  "keywords": [
    "react",
    "react-component",
    "wordcloud",
    "word-cloud",
    "tag-cloud",
    "d3",
    "d3js",
    "visualization",
    "data-viz",
    "typescript",
    "react18",
    "react19",
    "security",
    "modern"
  ],
  "author": "jjfive",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
